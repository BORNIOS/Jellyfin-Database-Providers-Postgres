<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the running Jellyfin binary (net9.0 / jellyfin 10.11.10) -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Database.Providers.Postgres</RootNamespace>
    <AssemblyName>Jellyfin.Database.Providers.Postgres</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ASP.NET Core is provided by the Jellyfin host process at runtime (net9.0) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin 10.11.10 public NuGet packages (same as what the deployed binary was compiled against) -->
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MediaBrowser.Common" Version="4.10.0.1-beta">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Jellyfin.Controller = NuGet package ID for MediaBrowser.Controller (ISystemManager lives here) -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- EF Core 9.x + Npgsql (matching what the binary ships: EF 9.0.11) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- SQLite driver for the in-process migration service — net9.0 version -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.6" />
  </ItemGroup>

  <!-- Embedded resources: schema SQL and config page HTML -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\schema.sql" />
    <EmbeddedResource Include="Web\configurationPage.html" />
  </ItemGroup>

</Project>
