<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Jellyfin.Database.Providers.Postgres.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <!--
    The plugin references the Jellyfin packages with ExcludeAssets="runtime" so they are not bundled into
    the plugin assembly. A test host does need them at runtime, so they are referenced here without that
    exclusion.

    The plugin is compiled against the oldest Jellyfin 12 release it supports (JellyfinVersion in the plugin
    project) and runs on every later one. The tests run by default on the newest supported release, which is
    where the schema drift guard and members added to IJellyfinDatabaseProvider matter; to run them on
    another one, pass the Jellyfin version and the EF Core version that release ships:

      dotnet test -p:JellyfinTestVersion=12.1.0 -p:EfCoreTestVersion=10.0.11
  -->
  <PropertyGroup>
    <JellyfinTestVersion Condition="'$(JellyfinTestVersion)' == ''">12.4.0</JellyfinTestVersion>
    <EfCoreTestVersion Condition="'$(EfCoreTestVersion)' == ''">10.0.14</EfCoreTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="$(JellyfinTestVersion)" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinTestVersion)" />
    <PackageReference Include="Jellyfin.Common" Version="$(JellyfinTestVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreTestVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Database.Providers.Postgres\Jellyfin.Database.Providers.Postgres.csproj" />
  </ItemGroup>

</Project>
